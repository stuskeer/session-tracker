PORT=3000

# These keys are not validated by DynamoDB Local, but some SDKs still expect them.
AWS_ACCESS_KEY_ID=dummy
AWS_SECRET_ACCESS_KEY=dummy

# Region can be anything, but keep it consistent.
DYNAMODB_REGION=us-east-1

# Point to your Pi's local DynamoDB container
DYNAMODB_ENDPOINT=http://192.168.1.49:8000
